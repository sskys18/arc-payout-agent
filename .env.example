# ----------------------------------------------------------------------------
# arc-payout-agent — environment template (PLACEHOLDERS ONLY, no real secrets)
# ----------------------------------------------------------------------------
# The dashboard runs with ZERO secrets out of the box: when none of the signer
# variables below are set it uses a deterministic MOCK signer and never touches
# a real RPC or Circle API. Fill these in only to run against the real testnet.

# --- Signer selection ---
# If CIRCLE_API_KEY is set, the Circle Programmable Wallets signer is used.
# Else if EOA_PRIVATE_KEY is set, the local EOA fallback signer is used.
# Else (default) -> MOCK signer (no on-chain calls).

# Circle Programmable Wallets API key (production custody path).
CIRCLE_API_KEY=
# Circle wallet id that holds the payout funds.
CIRCLE_WALLET_ID=

# Arc testnet JSON-RPC endpoint (used by the EOA fallback / live poll).
ARC_RPC_URL=https://rpc.testnet.arc.network

# USDC token contract address on Arc testnet.
USDC_ADDRESS=

# Local EOA fallback signer private key (DEV ONLY — never use real funds).
# Uncomment to use the EOA fallback path instead of the mock:
# EOA_PRIVATE_KEY=

# Durable storage for contractors/ledger if you wire a database later.
DATABASE_URL=

# Shared secret to gate admin/mutation API routes in a real deployment.
ADMIN_SECRET=
