{
  "name": "@arc/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable core primitives for arc-payout-agent: amounts, cadence, idempotency, append-only ledger, tx engine, signer abstractions.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./amounts": "./src/amounts.ts",
    "./cadence": "./src/cadence.ts",
    "./arcscan": "./src/arcscan.ts",
    "./idempotency": "./src/idempotency.ts",
    "./ledger": "./src/ledger.ts",
    "./txEngine": "./src/txEngine.ts",
    "./circle": "./src/circle.ts",
    "./payout/store": "./src/payout/store.ts",
    "./payout/agent": "./src/payout/agent.ts",
    "./payout/receipts": "./src/payout/receipts.ts"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "build": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
